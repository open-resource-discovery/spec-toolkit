ult 0;\\n  }\\n\\n  @Target(ElementType.TYPE)\\n  @Retention(RetentionPolicy.SOURCE)\\n  public @interface DefaultTest {\\n    String[] requiredFields() default {};\\n    String x() default \\"\\";\\n  }\\n\\n}"
