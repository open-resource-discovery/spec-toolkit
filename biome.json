{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/dist-*",
      "!!**/.test-dist",
      "!!**/reports",
      "!!**/coverage",
      "!!**/.next",
      "!!**/build",
      "!!**/.docusaurus",
      "!!**/vendor",
      "!!**/generated",
      "!!**/__snapshots__",
      "!!src/__tests__/tmpTestData-*",
      "!!src/__tests__/tmpTestOutput-*",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/storybook-static",
      "!**/package-lock.json",
      "!**/pnpm-lock.yaml",
      "!**/examples",
      "!**/fixtures",
      "!**/original-schema",
      "!**/.vscode-test",
      "!**/resources",
      "!**/test-data",
      "!**/testdata",
      "!**/*.scss",
      "!**/*.svg",
      "!**/.github/actions/**/dist",
      "!**/example",
      "!**/test-files",
      "!**/resources",
      "!**/schemas",
      "!**/static",
      "!**/res",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml",
      "!**/.github"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 120,
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": ["**", "!**/.github"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error",
        "noDuplicateObjectKeys": "error"
      },
      "style": {
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    },
    "globals": [
      "afterAll",
      "afterEach",
      "beforeAll",
      "beforeEach",
      "describe",
      "expect",
      "it",
      "jest",
      "setup",
      "suite",
      "teardown",
      "test"
    ],
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
