{
  "$schema": "http://json.schemastore.org/package",
  "name": "@open-resource-discovery/spec-toolkit",
  "version": "0.10.0",
  "description": "JSON Schema Toolkit CLI to create schema based interface documentation",
  "author": "SAP SE",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "./dist/cli.js",
  "files": [
    "README.md",
    "dist/"
  ],
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run build && docusaurus start website",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p ./tsconfig.build.json",
    "postbuild": "node ./scripts/postbuild.mjs",
    "build:website": "npm run build && docusaurus build website",
    "swizzle": "docusaurus swizzle website",
    "deploy": "docusaurus deploy website",
    "clear": "docusaurus clear website",
    "serve": "docusaurus serve website",
    "write-translations": "docusaurus write-translations website",
    "write-heading-ids": "docusaurus write-heading-ids website",
    "typecheck": "tsc --project website/tsconfig.json",
    "lint": "biome lint .",
    "lint:staged": "lint-staged",
    "biome": "biome check --write .",
    "biome:ci": "biome ci .",
    "build:test": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\" && tsc -p ./tsconfig.test.json",
    "test": "npm run build && npm run build:test && node scripts/run-tests.mjs",
    "test:coverage": "npm run build && npm run build:test && node scripts/run-tests.mjs --experimental-test-coverage --test-coverage-include='.test-dist/**/*.js' --test-coverage-exclude='.test-dist/**/*.test.js' --test-coverage-exclude='.test-dist/generated/**' --test-coverage-exclude='.test-dist/testHelpers/**'",
    "test:update-snapshots": "npm run build && npm run build:test && node scripts/run-tests.mjs --test-update-snapshots",
    "prepare": "is-ci || husky",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && oxfmt --no-error-on-unmatched-pattern '**/*.{md,yml,yaml,css,scss,html}'",
    "format:check": "biome format . && oxfmt --check --no-error-on-unmatched-pattern '**/*.{md,yml,yaml,css,scss,html}'",
    "check:tooling": "npm run lint && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-resource-discovery/spec-toolkit.git"
  },
  "homepage": "https://open-resource-discovery.github.io/spec-toolkit/",
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "11.9.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "comment-json": "5.0.0",
    "exceljs": "4.4.0",
    "fast-glob": "3.3.3",
    "fs-extra": "11.4.1",
    "gfm-escape": "0.2.0",
    "js-yaml": "5.5.0",
    "json-schema-to-typescript": "16.0.0",
    "quicktype-core": "26.0.0",
    "tslog": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@expo/spawn-async": "1.8.0",
    "@monaco-editor/react": "4.7.0",
    "@types/fs-extra": "11.0.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "@ui5/webcomponents-base": "2.26.0",
    "@ui5/webcomponents-icons": "2.26.0",
    "@ui5/webcomponents-react": "2.26.0",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "json-schema": "0.4.0",
    "json-schema-library": "11.6.16",
    "lint-staged": "17.6.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "@tsconfig/node22": "22.0.6",
    "oxfmt": "0.75.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,html}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{md,yml,yaml}": [
      "oxfmt"
    ]
  }
}
