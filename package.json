{
  "$schema": "http://json.schemastore.org/package",
  "name": "@open-resource-discovery/spec-toolkit",
  "version": "0.9.0",
  "description": "JSON Schema Toolkit CLI to create schema based interface documentation",
  "author": "SAP SE",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "./dist/cli.js",
  "files": [
    "README.md",
    "dist/"
  ],
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run build && docusaurus start website",
    "prebuild": "rimraf ./dist",
    "build": "tsc -p ./tsconfig.build.json",
    "postbuild": "mkdir -p website/docs/docs website/static/spec-v1 && npm run postbuild-spec-toolkit-config && npm run postbuild-spec",
    "postbuild-spec-toolkit-config": "node ./dist/cli.js -c ./spec-toolkit-config.config.json && cp ./src/generated/spec-toolkit-config/spec-v1/docs/spec-toolkit-config.md website/docs/docs/ && cp ./src/generated/spec-toolkit-config/spec-v1/schemas/* website/static/spec-v1/",
    "postbuild-spec": "node ./dist/cli.js -c ./spec.config.json && cp ./src/generated/spec/spec-v1/docs/spec.md website/docs/docs/ && cp ./src/generated/spec/spec-v1/schemas/* website/static/spec-v1/",
    "build:website": "npm run build && docusaurus build website",
    "swizzle": "docusaurus swizzle website",
    "deploy": "docusaurus deploy website",
    "clear": "docusaurus clear website",
    "serve": "docusaurus serve website",
    "write-translations": "docusaurus write-translations website",
    "write-heading-ids": "docusaurus write-heading-ids website",
    "typecheck": "tsc --project website/tsconfig.json",
    "lint": "npm run biome",
    "lint:staged": "lint-staged",
    "biome": "biome check --write .",
    "biome:ci": "biome ci .",
    "test": "npm run build && node --import tsx --test",
    "test:coverage": "npm run build && node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/__tests__/generated/**' --test-coverage-exclude='src/generated/**' --test-coverage-exclude='src/testHelpers/**'",
    "test:update-snapshots": "node --import tsx --test --test-update-snapshots",
    "test:watch": "node --import tsx --test --watch",
    "prepare": "is-ci || husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-resource-discovery/spec-toolkit.git"
  },
  "homepage": "https://open-resource-discovery.github.io/spec-toolkit/",
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "11.9.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "comment-json": "5.0.0",
    "exceljs": "4.4.0",
    "fast-glob": "3.3.3",
    "fs-extra": "11.4.0",
    "gfm-escape": "0.2.0",
    "js-yaml": "5.4.1",
    "json-schema-to-typescript": "16.0.0",
    "lodash": "4.18.1",
    "quicktype-core": "26.0.0",
    "tslog": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@expo/spawn-async": "1.8.0",
    "@monaco-editor/react": "4.7.0",
    "@tsconfig/node22": "22.0.6",
    "@types/fs-extra": "11.0.4",
    "@types/js-yaml": "4.0.9",
    "@types/lodash": "4.17.25",
    "@types/node": "26.5.0",
    "@ui5/webcomponents-base": "2.26.0",
    "@ui5/webcomponents-icons": "2.26.0",
    "@ui5/webcomponents-react": "2.26.0",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "json-schema": "0.4.0",
    "json-schema-library": "11.6.2",
    "lint-staged": "17.5.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "lint-staged": {
    "**/*.{js,ts,json,yml,yaml,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
